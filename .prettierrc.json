{
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-packagejson"
  ],
  "importOrder": ["<BUILTIN_MODULES>", "", "<THIRD_PARTY_MODULES>", "", "^[.]"],
  "overrides": [
    {
      "files": "*.md",
      "excludeFiles": "**/SKILL.md",
      "options": { "proseWrap": "always" }
    },
    {
      "files": ".github/**/*.md",
      "options": { "proseWrap": "never" }
    },
    {
      "files": "assets/**/*.svg",
      "options": { "parser": "html" }
    }
  ]
}
