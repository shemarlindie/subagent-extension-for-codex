{
  "plugins": ["prettier-plugin-packagejson"],
  "overrides": [
    {
      "files": "*.md",
      "excludeFiles": "**/SKILL.md",
      "options": { "proseWrap": "always" }
    },
    {
      "files": ".github/**/*.md",
      "options": { "proseWrap": "never" }
    },
    {
      "files": "assets/**/*.svg",
      "options": { "parser": "html" }
    }
  ]
}
