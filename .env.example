# Copy to .env (gitignored). Loaded by npm run dev, start, projects and dev:ui;
# variables already set in the shell take precedence. For the Codex-launched
# stdio proxy, mirror DATA/URL in its MCP env for the service connection.

# Persistent database, token, worktrees and logs. Relative paths resolve from
# the project root. Use the same absolute path in Codex's MCP environment.
SUBAGENT_EXTENSION_FOR_CODEX_DATA=.subagent-extension-for-codex/live

# Service port and public origin. With the plugin also installed, use another
# port (and mirror it in Codex's MCP env), so the two services don't collide.
# PORT=17317
# SUBAGENT_EXTENSION_FOR_CODEX_ORIGIN=http://127.0.0.1:17317

# Approve every Git root beneath these directories (JSON array).
# SUBAGENT_EXTENSION_FOR_CODEX_ALLOWED_ROOTS=["/absolute/path/to/projects"]
