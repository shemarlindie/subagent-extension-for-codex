# Copy to .env (gitignored). Loaded by npm run dev, start, projects and dev:ui;
# variables already set in the shell take precedence. The Codex-launched stdio
# proxy does not read this file: mirror DATA/URL in Codex's MCP env instead.

# Persistent database, token, worktrees and logs. Relative paths resolve from
# the project root. Use the same absolute path in Codex's MCP environment.
CODEX_SUBAGENT_EXTENSION_DATA=.codex-subagent-extension/live

# Service port and public origin.
# PORT=4317
# CODEX_SUBAGENT_EXTENSION_ORIGIN=http://127.0.0.1:4317

# Approve every Git root beneath these directories (JSON array).
# CODEX_SUBAGENT_EXTENSION_ALLOWED_ROOTS=["/absolute/path/to/projects"]
