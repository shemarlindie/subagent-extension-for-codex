{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/service/stdio.ts",
    "src/service/projects-cli.ts",
    "src/service/platform/service/node-version.ts",
    "src/panel/app/app.ts",
    "src/**/schema-generation.mjs",
    "dev/panel/host/panel.ts",
    "dev/panel/host/field-error-demo.tsx",
    "dev/panel/fixture-service/service.ts",
    "dev/service/demo-service.ts",
    "tests/contracts/**/*.typecheck.ts",
    "scripts/*.mjs"
  ],
  "ignoreBinaries": ["where"],
  "project": [
    "src/**/*.{ts,tsx,mjs}",
    "dev/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
