{
  "name": "codex-subagent-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable Claude delegation for Codex",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "test": "tsx --tsconfig ui/tsconfig.json --test tests/*.test.ts",
    "mcp": "node dist/stdio.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "format": "prettier --write src ui tests scripts plugin.json mcp.json package.json tsconfig.json",
    "pretest": "npm run build",
    "projects": "node dist/projects-cli.js",
    "prepack": "npm run build",
    "package:plugin": "npm pack"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@openai/mcp-extensions": "^0.1.0",
    "express": "^5.0.0",
    "ipaddr.js": "^2.5.0",
    "openai": "^7.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "plugin.json",
    "mcp.json",
    "skills",
    "README.md",
    "docs"
  ],
  "bundleDependencies": [
    "@anthropic-ai/claude-agent-sdk",
    "@modelcontextprotocol/ext-apps",
    "@modelcontextprotocol/node",
    "@modelcontextprotocol/sdk",
    "@modelcontextprotocol/server",
    "@openai/mcp-extensions",
    "express",
    "ipaddr.js",
    "openai",
    "standardwebhooks",
    "zod"
  ]
}
