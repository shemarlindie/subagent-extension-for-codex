{
  "name": "subagent-extension-for-codex",
  "version": "0.4.0",
  "private": true,
  "description": "Delegate to Claude without leaving Codex.",
  "keywords": [
    "codex",
    "codex-cli",
    "codex-plugin",
    "claude-code",
    "subagents",
    "codex-subagents",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents"
  ],
  "homepage": "https://github.com/shemarlindie/subagent-extension-for-codex#readme",
  "bugs": {
    "url": "https://github.com/shemarlindie/subagent-extension-for-codex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shemarlindie/subagent-extension-for-codex.git"
  },
  "license": "MIT",
  "author": "Shemar Lindie",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "plugin.json",
    "mcp.json",
    "assets",
    "skills"
  ],
  "scripts": {
    "build": "npm run schemas:generate && tsc --noEmit && npm run build:bundles",
    "build:bundles": "npm run clean && node scripts/build-service.mjs && node scripts/build-panel.mjs",
    "check": "npm run schemas:check && node scripts/run-parallel.mjs check:source build:bundles",
    "check:claude-policy": "node scripts/check-claude-policy.mjs",
    "check:source": "node scripts/run-parallel.mjs format:check lint knip typecheck:source",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "db:generate": "drizzle-kit generate",
    "demo": "npm run build && node scripts/demo.mjs",
    "predev": "npm run schemas:generate",
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/service/main.ts",
    "dev:plugin": "node scripts/dev-plugin.mjs",
    "dev:reset": "node --import tsx --env-file-if-exists=.env dev/service/reset-data.ts",
    "dev:ui": "vite",
    "fixture:record": "tsx dev/panel/recording/record-fixture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache .",
    "knip": "knip",
    "lint": "eslint .",
    "mcp": "node --enable-source-maps dist/stdio.js",
    "prepack": "npm run build",
    "package:plugin": "npm pack",
    "projects": "node --enable-source-maps --env-file-if-exists=.env dist/projects-cli.js",
    "release:assemble": "node scripts/assemble-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "showcase:capture": "tsx dev/panel/showcase/capture.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "pretest": "npm run schemas:check",
    "test": "node scripts/run-parallel.mjs check:source test:built",
    "test:built": "npm run build:bundles && playwright test && vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit --project unit-dom",
    "test:watch": "vitest",
    "typecheck": "npm run schemas:check && npm run typecheck:source",
    "typecheck:source": "tsc --noEmit && tsc -p tsconfig.panel.json && tsc -p tsconfig.test.json"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "$zod"
    },
    "katex": "^0.19.1",
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@formkit/auto-animate": "^0.10.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openai/mcp-extensions": "^0.2.1",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.3.0",
    "diff": "9.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "parse-diff": "^0.12.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.22.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.6",
    "ts-to-zod": "5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
