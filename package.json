{
  "name": "codex-subagent-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude delegation for Codex",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/service/main.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run schemas:generate && npm run clean && tsc --noEmit && node scripts/build-service.mjs && node scripts/build-panel.mjs",
    "typecheck": "npm run schemas:check && tsc --noEmit && tsc -p tsconfig.panel.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "mcp": "node --enable-source-maps dist/stdio.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "format": "prettier --write .",
    "pretest": "npm run schemas:check && npm run format:check && npm run lint && npm run build",
    "projects": "node --enable-source-maps --env-file-if-exists=.env dist/projects-cli.js",
    "prepack": "npm run build",
    "package:plugin": "npm pack",
    "dev:ui": "vite",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fixture:record": "tsx dev/panel/recording/record-fixture.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate-legacy": "tsx --env-file-if-exists=.env dev/database/migrate-legacy-database.ts",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "predev": "npm run schemas:generate"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express": "^5.2.1",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.2",
    "parse-diff": "^0.12.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.3",
    "remark-gfm": "^4.0.1",
    "standardwebhooks": "^1.1.1",
    "ts-to-zod": "5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "migrations",
    "plugin.json",
    "mcp.json",
    "assets",
    "skills",
    "README.md",
    "docs"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
