{
  "name": "codex-subagent-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude delegation for Codex",
  "license": "MIT",
  "author": "Shemar Lindie",
  "homepage": "https://github.com/shemarlindie/codex-subagent-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shemarlindie/codex-subagent-extension.git"
  },
  "bugs": {
    "url": "https://github.com/shemarlindie/codex-subagent-extension/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/service/main.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run schemas:generate && tsc --noEmit && npm run build:bundles",
    "typecheck": "npm run schemas:check && npm run typecheck:source",
    "test": "node scripts/run-parallel.mjs check:source test:built",
    "mcp": "node --enable-source-maps dist/stdio.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "format": "prettier --write .",
    "pretest": "npm run schemas:check",
    "projects": "node --enable-source-maps --env-file-if-exists=.env dist/projects-cli.js",
    "prepack": "npm run build",
    "package:plugin": "npm pack",
    "dev:ui": "vite",
    "format:check": "prettier --check --cache .",
    "test:watch": "vitest",
    "lint": "eslint .",
    "knip": "knip",
    "fixture:record": "tsx dev/panel/recording/record-fixture.ts",
    "showcase:capture": "tsx dev/panel/showcase/capture.ts",
    "db:generate": "drizzle-kit generate",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "predev": "npm run schemas:generate",
    "release:assemble": "node scripts/assemble-release.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "test:unit": "vitest run --project unit --project unit-dom",
    "test:integration": "vitest run --project integration",
    "build:bundles": "npm run clean && node scripts/build-service.mjs && node scripts/build-panel.mjs",
    "typecheck:source": "tsc --noEmit && tsc -p tsconfig.panel.json && tsc -p tsconfig.test.json",
    "check": "npm run schemas:check && node scripts/run-parallel.mjs check:source build:bundles",
    "check:source": "node scripts/run-parallel.mjs format:check lint knip typecheck:source",
    "test:built": "npm run build:bundles && playwright test && vitest run"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@formkit/auto-animate": "^0.10.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openai/mcp-extensions": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "9.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express": "^5.2.1",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "knip": "6.41.0",
    "parse-diff": "^0.12.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ts-to-zod": "5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "migrations",
    "plugin.json",
    "mcp.json",
    "assets",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "$zod"
    }
  }
}
