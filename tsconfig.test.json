{
  "extends": "./tsconfig.panel.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    // vite.config.ts imports its plugin with the extension Node's native loader needs.
    "allowImportingTsExtensions": true
  },
  "exclude": [],
  "include": [
    "tests",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*-test-harness.ts",
    "dev",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts"
  ]
}
